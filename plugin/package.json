{
  "name": "trans-genderian-orchestra",
  "version": "0.2.1",
  "description": "TGO — a thin multi-agent orchestration plugin for OpenCode",
  "license": "MIT",
  "repository": "https://github.com/octini/trans-genderian-orchestra",
  "homepage": "https://github.com/octini/trans-genderian-orchestra",
  "bugs": {
    "url": "https://github.com/octini/trans-genderian-orchestra/issues"
  },
  "type": "module",
  "main": "src/plugin.ts",
  "exports": {
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "assets",
    "schema",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "bun run src/validate.ts",
    "benchmark:style-quality": "bun run benchmark/style-quality.ts --check",
    "setup": "bun run src/install.ts",
    "build": "bun run src/build.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "~1.18.13",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "solid-js": "1.9.12",
    "@opentui/solid": "0.5.1",
    "@opentui/core": "0.5.1"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/solid": "0.5.1",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "~5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
