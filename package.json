{
  "name": "trans-genderian-orchestra",
  "version": "2.0.0-beta.4",
  "description": "TGO v2 OpenCode engineering workflow plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/octini/trans-genderian-orchestra.git"
  },
  "bugs": {
    "url": "https://github.com/octini/trans-genderian-orchestra/issues"
  },
  "homepage": "https://github.com/octini/trans-genderian-orchestra",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "agents",
    "orchestration",
    "llm"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "trans-genderian-orchestra": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "MIGRATION.md",
    "RELEASE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean:dist": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build:plugin": "bun build src/index.ts --outdir dist --target node --format esm --external @opencode-ai/plugin --external zod",
    "build:cli": "bun build src/cli/index.ts --outdir dist/cli --target node --format esm --external zod",
    "build": "bun run clean:dist && bun run build:plugin && bun run build:cli && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns archive",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check:ci": "biome check .",
    "verify:release-readiness": "bun run scripts/verify-release-readiness.ts",
    "verify:public-beta-opencode": "bun run scripts/verify-public-beta-opencode.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/node": "^24.6.1",
    "bun-types": "1.3.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
